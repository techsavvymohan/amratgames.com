# ═════════════════════════════════════════════════════════════════════════════════
# AmratGames Frontend Web Client — Environment Template (.env.example)
# Variables exposed to the browser MUST start with VITE_
# ═════════════════════════════════════════════════════════════════════════════════

# Backend API endpoint (in dev, Vite proxy maps /api -> http://localhost:3001/api)
VITE_API_URL=/api

# Real-time WebSocket connection URL
VITE_WS_URL=ws://localhost:3001/ws

# Platform Branding
VITE_APP_NAME=AmratGames.com
VITE_APP_TAGLINE=India's Premier Crypto & INR Gaming Platform
VITE_CURRENCY_DEFAULT=INR

# Customer Support
VITE_SUPPORT_EMAIL=support@amratgames.com
VITE_SUPPORT_TELEGRAM=@AmratGamesSupport
