# ═════════════════════════════════════════════════════════════════════════════════
# AmratGames.com — Master Environment Configuration Template (.env.example)
# Copy this file to '.env' and customize values for your deployment.
# ═════════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 1. APPLICATION & SERVER SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Allowed CORS origins (comma-separated for multiple origins, or * for all)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://amratgames.com

# ─────────────────────────────────────────────────────────────────────────────
# 2. SECURITY & JWT AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────────────
# Generate a secure 64+ char random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=amrat_royal_secure_jwt_secret_change_me_in_production_2025_987654321
JWT_EXPIRES_IN=7d

# Internal Admin API Secret Header for automated cron jobs or monitoring
ADMIN_API_KEY=amrat_internal_secret_admin_key_2025

# ─────────────────────────────────────────────────────────────────────────────
# 3. DEFAULT MASTER ADMIN ACCOUNT
# (Provisioned automatically on first server boot if no admin exists)
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@amratgames.com
ADMIN_PHONE=9876500001
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME=Amrat Master Admin

# ─────────────────────────────────────────────────────────────────────────────
# 4. DATABASE & PERSISTENCE (Supabase PostgreSQL / Local File DB)
# ─────────────────────────────────────────────────────────────────────────────
# Local Database directory (fallback when offline or for development)
DATA_DIR=./data
DB_FILE=amratgames_db.json

# Supabase PostgreSQL Cloud Integration
# Set USE_SUPABASE=true and supply your project credentials from Supabase Dashboard -> Settings -> API
USE_SUPABASE=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Redis URL for distributed session cache or rate-limiting in cluster mode
# REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# 5. SMS & OTP VERIFICATION GATEWAY
# (Used for mobile phone verification on registration and Fast OTP login)
# ─────────────────────────────────────────────────────────────────────────────
# Options: 'mock' (logs OTP to server console) | 'fast2sms' | 'msg91' | 'twilio'
SMS_GATEWAY_PROVIDER=mock
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here
SMS_GATEWAY_SENDER_ID=AMRATG

# For local development and demo QA: Enable demo bypass codes
DEMO_OTP_BYPASS_ENABLED=true
DEMO_OTP_CODE=777777

# ─────────────────────────────────────────────────────────────────────────────
# 5B. OFFICIAL SUPPORT & OUTGOING EMAIL (SPACEMAIL / SPACESHIP SMTP)
# ─────────────────────────────────────────────────────────────────────────────
SUPPORT_EMAIL=support@amratgames.com
# Spaceship Spacemail Outgoing Server Settings
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@amratgames.com
SMTP_PASS=your_spacemail_password_here
SMTP_FROM="AmratGames Support <support@amratgames.com>"

# ─────────────────────────────────────────────────────────────────────────────
# 6. INDIAN PAYMENTS & UPI DEPOSITS (INR ₹)
# ─────────────────────────────────────────────────────────────────────────────
UPI_MERCHANT_VPA=amratgames@upi
UPI_MERCHANT_NAME=AmratGames India

# Optional: Razorpay payment gateway integration
# RAZORPAY_KEY_ID=rzp_live_your_key_here
# RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# 7. CRYPTO DEPOSIT WALLET ADDRESSES
# ─────────────────────────────────────────────────────────────────────────────
CRYPTO_RECEIVER_BTC=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh
CRYPTO_RECEIVER_USDT=0x71C8360f3E10D5371b3722133D141C0E500C7D52

# Optional: Dodo Payments Webhook / Checkout Integration
# DODO_PAYMENTS_API_KEY=dodo_live_your_api_key_here
# DODO_PAYMENTS_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# 8. TOKEN ECONOMY ($AMRAT) & CASINO GAME MATHEMATICS
# ─────────────────────────────────────────────────────────────────────────────
TOKEN_NAME=Amrat Royal Token
TOKEN_SYMBOL=AMRAT
TOKEN_INITIAL_TREASURY=100000000
TOKEN_DECIMALS=2

# Default Return to Player (RTP %) and House Edge (%)
DEFAULT_RTP=99.00
HOUSE_EDGE=1.00
MIN_BET_INR=10
MAX_BET_INR=200000

# ─────────────────────────────────────────────────────────────────────────────
# 9. FRONTEND CLIENT CONFIGURATION (Vite VITE_* variables)
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=/api
VITE_WS_URL=ws://localhost:3001/ws
VITE_APP_NAME=AmratGames.com
VITE_APP_TAGLINE=India's Premier Crypto & INR Gaming Platform
VITE_CURRENCY_DEFAULT=INR
VITE_SUPPORT_EMAIL=support@amratgames.com
VITE_SUPPORT_TELEGRAM=@AmratGamesSupport
