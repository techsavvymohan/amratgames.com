{
  "name": "amratgames-workspace",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "AmratGames.com - Premier Provably Fair Crypto & INR Casino",
  "scripts": {
    "start": "node backend/src/server.js",
    "start:backend": "node backend/src/server.js",
    "dev": "pnpm --filter ./frontend dev",
    "dev:backend": "pnpm --filter ./backend dev",
    "dev:frontend": "pnpm --filter ./frontend dev",
    "build": "pnpm --filter ./frontend build",
    "build:frontend": "pnpm --filter ./frontend build",
    "preview": "pnpm --filter ./frontend preview",
    "test": "pnpm --filter ./backend test && pnpm --filter ./frontend test",
    "test:backend": "pnpm --filter ./backend test",
    "test:frontend": "pnpm --filter ./frontend test",
    "check": "node --check backend/src/server.js && node --check backend/src/config.js",
    "setup:env": "node scripts/setup-env.js",
    "deploy:gateway": "node scripts/deploy-gateway-vps.mjs",
    "optimize:nginx": "node scripts/optimize-nginx.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  }
}
